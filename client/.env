# Backend origin — no trailing slash
VITE_API_BASE_URL=http://127.0.0.1:8000

# API path prefix — must match backend's /api/v1
VITE_API_PREFIX=/api/v1

# Fetch timeout in milliseconds
VITE_REQUEST_TIMEOUT_MS=30000

# Max upload size — must match backend MAX_UPLOAD_MB
VITE_MAX_UPLOAD_MB=10

# Comma-separated accepted MIME types
VITE_ALLOWED_MIME=image/jpeg,image/png,image/webp

# App display name
VITE_APP_NAME=SceneSense

# GitHub repository URL (leave blank to hide GitHub link)
VITE_GITHUB_URL=

# How often to poll /health in milliseconds
VITE_HEALTH_POLL_MS=30000
